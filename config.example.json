{
  "listen": ":7864",
  "api_key": "***",
  "auth_dir": "./auths",
  "state_file": "./data/state.json",
  "base_url": "https://code.phanthy.com",
  "cooldown": {
    "hard_credit": "12h",
    "soft_rate": "60s",
    "err_threshold": 3,
    "err_cooldown": "10m"
  },
  "schedule": {
    "keepalive_hours": [22],
    "probe_interval": "0"
  },
  "fingerprint": {
    "enabled": true,
    "cli_version": "0.2.11",
    "client": "cli",
    "client_source": "cli",
    "product": "phanthy_code",
    "user_agent": "",
    "device_json": ""
  },
  "upstream": {
    "timeout_seconds": 120
  }
}