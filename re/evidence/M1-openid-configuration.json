{
    "issuer": "https://code.phanthy.com",
    "authorization_endpoint": "https://code.phanthy.com/oauth/authorize",
    "token_endpoint": "https://code.phanthy.com/oauth/token",
    "revocation_endpoint": "https://code.phanthy.com/oauth/revoke",
    "jwks_uri": "https://code.phanthy.com/.well-known/jwks.json",
    "response_types_supported": [
        "code"
    ],
    "grant_types_supported": [
        "authorization_code",
        "refresh_token"
    ],
    "code_challenge_methods_supported": [
        "S256"
    ],
    "token_endpoint_auth_methods_supported": [
        "none"
    ],
    "scopes_supported": [
        "user:profile",
        "user:inference",
        "user:sessions:claude_code",
        "user:mcp_servers",
        "user:file_upload"
    ]
}
